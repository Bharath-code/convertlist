```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/

# Dependencies
node_modules/
venv/
.venv/
.env
.env.local
*.env.*

# Logs and temp files
*.log
*.tmp
*.swp

# Editors
.vscode/
.idea/

# Build outputs
dist/
build/
target/
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out

# Coverage
coverage/
htmlcov/
.coverage

# Cache
.mypy_cache/
.pytest_cache/
.gradle/
julia-*/
zig*/

# System files
.DS_Store
Thumbs.db
```