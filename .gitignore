```gitignore
# Compiled and build artifacts
*.tsbuildinfo
*.js
*.js.map
*.d.ts
dist/
build/
.out/
.bundle/

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*
!.env.example

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log

# Coverage
coverage/
.nyc_output/
istanbul/
.jest/

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db

# Bundler
.svelte-kit/
.vercel/
.netlify/
public/build/

# TypeScript
tsconfig.tsbuildinfo
```